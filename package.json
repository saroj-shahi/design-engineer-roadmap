{
  "name": "design-engineer-roadmap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "icons": "node scripts/og/render.mjs",
    "pdfs": "node scripts/pdf/render.mjs",
    "lint": "eslint .",
