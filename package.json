    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
